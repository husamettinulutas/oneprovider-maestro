{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": ["src", "vscode.proposed.languageModelThinkingPart.d.ts", "vscode.proposed.chatProvider.d.ts"],
  "exclude": ["node_modules", "dist", "webview"]
}
